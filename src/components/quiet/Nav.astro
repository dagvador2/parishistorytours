---
import { useTranslations } from '../../i18n/utils';
import { waLink } from '../../lib/whatsapp';

interface Props {
  /**
   * "home" uses in-page anchors (#tours, #route…).
   * "tour" (or other) prefixes them with the localized root so they jump back to the homepage.
   */
  context?: 'home' | 'tour';
  /**
   * Override for the "Book a Tour" button target. Tour pages pass "#book" so
   * the CTA scrolls to their own booking card instead of leaving for the
   * homepage (which would lose the pre-selected tour).
   */
  book?: string;
  /**
   * Explicit language-switcher targets, for pages whose two locales do not
   * share a path (blog articles: /blog/<en-slug> vs /fr/blog/<fr-slug>).
   * Pass null when no translation exists — the switcher then falls back to a
   * sensible page in that language rather than a mirrored URL that 404s.
   */
  enHref?: string | null;
  frHref?: string | null;
}

const { context = 'home', book, enHref, frHref } = Astro.props;
const hasExplicitAlternates = enHref !== undefined || frHref !== undefined;

const lang = Astro.locals.lang;
const t = useTranslations(lang);
const isDefaultLang = lang === 'en';
const langPrefix = isDefaultLang ? '' : '/fr';
const homeRoot = `${langPrefix}/`;

const anchor = (hash: string) => context === 'home' ? `#${hash}` : `${homeRoot}#${hash}`;

const links = [
  { key: 'tours',   href: anchor('tours'),   label: t('quiet.nav.tours') },
  { key: 'route',   href: anchor('route'),   label: t('quiet.nav.route') },
  { key: 'about',   href: anchor('about'),   label: t('quiet.nav.about') },
  { key: 'self-guided', href: `${langPrefix}/self-guided-tour/`, label: t('quiet.nav.selfGuided') },
];

const bookHref = book ?? (context === 'home' ? '#book' : `${homeRoot}#book`);
const waHref = waLink(t('quiet.wa.generic') as string);

// Language switcher — lives in the nav since the black top bar was removed.
// Normalize to a trailing slash so the links match the canonical URLs and the
// sitemap, otherwise Search Console sees two URLs per page.
const pathname = Astro.url.pathname;
const stripped = pathname.startsWith('/fr') ? (pathname.replace(/^\/fr/, '') || '/') : pathname;
const basePath = stripped.endsWith('/') ? stripped : `${stripped}/`;
const withSlash = (href: string) => (href.endsWith('/') ? href : `${href}/`);
// Untranslated page: send the visitor to the section root in the language they
// asked for. Better than mirroring a path that only exists in one locale.
const fallback = (prefix: string) =>
  `${prefix}${stripped.startsWith('/blog') ? 'blog/' : ''}`;
const enUrl = hasExplicitAlternates ? (enHref ? withSlash(enHref) : fallback('/')) : basePath;
const frUrl = hasExplicitAlternates ? (frHref ? withSlash(frHref) : fallback('/fr/')) : `/fr${basePath}`;
---

<nav class="quiet-nav" data-quiet-nav>
  <div class="quiet-nav__inner">
    <a href={homeRoot} class="quiet-nav__brand">
      <span class="quiet-nav__mark" aria-hidden="true">P</span>
      <span class="quiet-nav__brand-text">
        <span class="quiet-nav__brand-name">{t('quiet.nav.brand')}</span>
        <span class="quiet-nav__brand-sub">{t('quiet.nav.tagline')}</span>
      </span>
    </a>

    <div class="quiet-nav__links">
      {links.map((l) => (
        <a href={l.href} data-nav-link={l.key} class="quiet-nav__link">{l.label}</a>
      ))}
    </div>

    <div class="quiet-nav__right">
      <div class="quiet-nav__lang" role="group" aria-label="Language">
        <a href={enUrl} class:list={["quiet-nav__lang-item", { 'is-active': lang === 'en' }]} hreflang="en">EN</a>
        <span class="quiet-nav__lang-sep" aria-hidden="true">/</span>
        <a href={frUrl} class:list={["quiet-nav__lang-item", { 'is-active': lang === 'fr' }]} hreflang="fr">FR</a>
      </div>
      <a href={bookHref} class="quiet-nav__book" data-track="nav_book">{t('quiet.nav.bookTour')}</a>
      <button class="quiet-nav__burger" id="quietNavBurger" aria-label={t('quiet.nav.menuLabel')} aria-expanded="false" aria-controls="quietDrawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="quiet-drawer" id="quietDrawer" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="quiet-drawer__scrim" data-drawer-dismiss></div>
  <aside class="quiet-drawer__panel">
    <header class="quiet-drawer__head">
      <a href={homeRoot} class="quiet-drawer__brand" data-drawer-dismiss>
        <span class="quiet-drawer__mark" aria-hidden="true">P</span>
        <span class="quiet-drawer__brand-text">
          <span class="quiet-drawer__brand-name">{t('quiet.nav.brand')}</span>
          <span class="quiet-drawer__brand-sub">{t('quiet.nav.tagline')}</span>
        </span>
      </a>
      <button class="quiet-drawer__close" id="quietDrawerClose" aria-label="Close menu">×</button>
    </header>
    <nav class="quiet-drawer__nav">
      {links.map((l) => (
        <a href={l.href} class="quiet-drawer__link" data-drawer-dismiss>{l.label}</a>
      ))}
      <a href={bookHref} class="quiet-drawer__link quiet-drawer__link--cta" data-drawer-dismiss data-track="nav_book_mobile">{t('quiet.nav.bookTour')}</a>
    </nav>
    <div class="quiet-drawer__foot">
      <a href={waHref} class="quiet-drawer__foot-item" rel="noopener">+33 6 20 62 24 80</a>
      <div class="quiet-drawer__lang" role="group" aria-label="Language">
        <a href={enUrl} class:list={["quiet-drawer__lang-item", { 'is-active': lang === 'en' }]} hreflang="en">EN</a>
        <span aria-hidden="true">/</span>
        <a href={frUrl} class:list={["quiet-drawer__lang-item", { 'is-active': lang === 'fr' }]} hreflang="fr">FR</a>
      </div>
    </div>
  </aside>
</div>

<style>
  .quiet-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper-3);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-sans);
  }
  .quiet-nav__inner {
    max-width: 1280px;
    margin: 0 auto;
    height: 70px;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .quiet-nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .quiet-nav__mark {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--ink);
  }
  .quiet-nav__brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .quiet-nav__brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.01em;
  }
  .quiet-nav__brand-sub {
    font-size: 11px;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .quiet-nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .quiet-nav__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .quiet-nav__link:hover { color: var(--ink); }
  .quiet-nav__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .quiet-nav__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .quiet-nav__lang {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .quiet-nav__lang-item {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    padding: 2px 1px;
    transition: color 120ms ease;
  }
  .quiet-nav__lang-item:hover { color: var(--ink); }
  .quiet-nav__lang-item.is-active {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .quiet-nav__lang-sep { color: var(--border); }

  .quiet-nav__book {
    background: var(--ink);
    color: var(--paper-3);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 10px 18px;
    border-radius: 2px;
    text-decoration: none;
    border: 1px solid var(--ink);
    transition: background 120ms ease, color 120ms ease;
  }
  .quiet-nav__book:hover {
    background: transparent;
    color: var(--ink);
  }

  .quiet-nav__burger {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    padding: 0;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    color: var(--ink);
  }
  .quiet-nav__burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
  }

  @media (max-width: 900px) {
    .quiet-nav__links { display: none; }
    .quiet-nav__brand-sub { display: none; }
  }

  @media (max-width: 760px) {
    .quiet-nav__inner { padding: 0 16px; }
    .quiet-nav__book { display: none; }
    /* EN/FR lives in the drawer footer on mobile — keeping it in the bar too
       would crowd the 375px header. */
    .quiet-nav__lang { display: none; }
    .quiet-nav__burger { display: flex; }
  }

  /* --- Mobile drawer --- */
  .quiet-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    pointer-events: none;
    font-family: var(--font-sans);
  }
  .quiet-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }
  .quiet-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.35);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .quiet-drawer.is-open .quiet-drawer__scrim { opacity: 1; }
  .quiet-drawer__panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(92%, 400px);
    background: var(--paper-3);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: -4px 0 24px -8px rgba(0, 0, 0, 0.12);
  }
  .quiet-drawer.is-open .quiet-drawer__panel { transform: translateX(0); }

  .quiet-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }
  .quiet-drawer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .quiet-drawer__mark {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
  }
  .quiet-drawer__brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .quiet-drawer__brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }
  .quiet-drawer__brand-sub {
    font-size: 10px;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
  .quiet-drawer__close {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 28px;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-display);
  }
  .quiet-drawer__close:hover { border-color: var(--ink); }

  .quiet-drawer__nav {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    flex: 1;
  }
  .quiet-drawer__link {
    display: block;
    padding: 16px 20px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 120ms ease;
  }
  .quiet-drawer__link:hover { background: var(--paper-2); }
  .quiet-drawer__link--cta {
    margin-top: 8px;
    background: var(--ink);
    color: var(--paper-3);
    text-align: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 18px 20px;
    border-bottom: none;
    letter-spacing: 0.02em;
  }
  .quiet-drawer__link--cta:hover { background: var(--rouge); color: var(--paper-3); }

  .quiet-drawer__foot {
    padding: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .quiet-drawer__foot-item {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--ink-2);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .quiet-drawer__foot-item:hover { color: var(--ink); }
  .quiet-drawer__lang {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--border);
    letter-spacing: 0.06em;
  }
  .quiet-drawer__lang-item {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
  }
  .quiet-drawer__lang-item.is-active { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 761px) {
    .quiet-drawer { display: none; }
  }
</style>

<script>
  const burger = document.getElementById('quietNavBurger');
  const drawer = document.getElementById('quietDrawer');
  const closeBtn = document.getElementById('quietDrawerClose');

  if (burger && drawer) {
    function open() {
      drawer!.classList.add('is-open');
      drawer!.setAttribute('aria-hidden', 'false');
      burger!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      drawer!.classList.remove('is-open');
      drawer!.setAttribute('aria-hidden', 'true');
      burger!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    burger.addEventListener('click', () => {
      if (drawer.classList.contains('is-open')) close();
      else open();
    });
    closeBtn?.addEventListener('click', close);
    // Scrim and link clicks all carry data-drawer-dismiss
    drawer.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('[data-drawer-dismiss]')) close();
    });
    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
    });
  }
</script>
