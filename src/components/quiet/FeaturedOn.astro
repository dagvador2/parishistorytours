---
import { useTranslations } from '../../i18n/utils';
import PartnerLogos from './PartnerLogos.astro';

const lang = Astro.locals.lang;
const t = useTranslations(lang);
---

<section class="qfeatured">
  <div class="qfeatured__inner">
    <PartnerLogos label={t('quiet.about.featured.label') as string} />
  </div>
</section>

<style>
  .qfeatured {
    background: var(--paper-2);
    padding: 56px 32px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .qfeatured__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  @media (max-width: 760px) {
    .qfeatured { padding: 40px 20px; }
  }
</style>
