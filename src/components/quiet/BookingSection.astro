---
import { useTranslations } from '../../i18n/utils';
import { waLink } from '../../lib/whatsapp';
import BookTour from '../BookTour.astro';
import PartnerLogos from './PartnerLogos.astro';

interface Props {
  /** Passed through to the underlying BookingWizard for tour-detail pages. */
  tourFilter?: string;
}

const { tourFilter } = Astro.props;

const lang = Astro.locals.lang;
const t = useTranslations(lang);

const waHref = waLink(t('quiet.wa.generic') as string);

const privatePoints = [
  t('quiet.home.booking.privatePoint1'),
  t('quiet.home.booking.privatePoint2'),
  t('quiet.home.booking.privatePoint3'),
];

// Google is the one listing that isn't a booking channel, so it stays out of
// the "also book on" row even though it appears in "also featured on".
const bookingPartners = {
  getyourguide: true as const,
  viator: true as const,
  airbnb: true as const,
  tripadvisor: true as const,
  tourist: true as const,
  parisjetaime: true as const,
};
---

<section id="book" class="qbook">
  <div class="qbook__inner">
    <header class="qbook__header">
      <p class="qbook__kicker">{t('quiet.home.booking.kicker')}</p>
      <h2 class="qbook__title">{t('quiet.home.booking.title')}</h2>
      <p class="qbook__desc">{t('quiet.home.booking.description')}</p>
    </header>

    {/* Block 1 — the private tour leads: it is the offer we push, so it gets
        the first slot, its own panel and its own big CTA. */}
    <div class="qbook__block qbook__block--private">
      <div class="qbook__private">
        <div class="qbook__private-copy">
          <span class="qbook__step qbook__step--invert">{t('quiet.home.booking.privateStep')}</span>
          <h3 class="qbook__private-title">{t('quiet.home.booking.privateHeading')}</h3>
          <p class="qbook__private-desc">{t('quiet.home.booking.privateDescription')}</p>
          <ul class="qbook__private-points">
            {privatePoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
        <div class="qbook__private-actions">
          <button type="button" class="qbook__private-cta" data-private-tour data-track="book_private">
            {t('quiet.home.booking.privateCta')} <span aria-hidden="true">→</span>
          </button>
          <a href={waHref} class="qbook__private-wa" rel="noopener">{t('quiet.home.booking.privateWhatsapp')}</a>
        </div>
      </div>
    </div>

    {/* Block 2 — the scheduled sessions, booked through the wizard */}
    <div class="qbook__block">
      <div class="qbook__block-head qbook__block-head--scheduled">
        <span class="qbook__step">{t('quiet.home.booking.scheduledStep')}</span>
        <h3 class="qbook__block-title">{t('quiet.home.booking.scheduledHeading')}</h3>
        <p class="qbook__block-desc">{t('quiet.home.booking.scheduledDescription')}</p>
      </div>
      {/* Swapped in by the script below once the wizard is on its private path,
          so the form never sits under a "scheduled walks" heading. */}
      <div class="qbook__block-head qbook__block-head--private">
        <span class="qbook__step">{t('quiet.home.booking.privateStep')}</span>
        <h3 class="qbook__block-title">{t('quiet.home.booking.privateHeading')}</h3>
        <p class="qbook__block-desc">{t('quiet.home.booking.privateDescription')}</p>
      </div>
      <div class="qbook__wizard">
        <BookTour tourFilter={tourFilter} hideChrome={true} hidePrivateLink={true} />
      </div>
    </div>

    <div class="qbook__chips">
      <a class="qbook__chip" href={waHref} rel="noopener">
        <span class="qbook__chip-label">{t('quiet.home.booking.whatsappLabel')}</span>
        <span class="qbook__chip-value">+33 6 20 62 24 80</span>
      </a>
      <a class="qbook__chip" href="mailto:clement@parishistorytours.com">
        <span class="qbook__chip-label">{t('quiet.home.booking.emailLabel')}</span>
        <span class="qbook__chip-value">clement@parishistorytours.com</span>
      </a>
    </div>

    <div class="qbook__partners">
      <PartnerLogos label={t('quiet.home.booking.partnerLabel') as string} links={bookingPartners} />
    </div>
  </div>
</section>

<style>
  .qbook {
    background: var(--paper);
    padding: 96px 32px;
    border-top: 1px solid var(--border);
  }
  .qbook__inner { max-width: 1100px; margin: 0 auto; }
  .qbook__header { margin-bottom: 48px; max-width: 720px; }
  .qbook__kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 16px;
  }
  .qbook__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.2vw, 48px);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 20px;
    line-height: 1.1;
  }
  .qbook__desc {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
  }

  /* --- shared block chrome --- */
  .qbook__block + .qbook__block { margin-top: 40px; }
  .qbook__block-head { margin-bottom: 24px; }
  .qbook__block-head--private { display: none; }
  .qbook[data-booking-mode="private"] .qbook__block-head--scheduled { display: none; }
  .qbook[data-booking-mode="private"] .qbook__block-head--private { display: block; }
  /* The panel has done its job once the private form is open. */
  .qbook[data-booking-mode="private"] .qbook__block--private { display: none; }
  .qbook[data-booking-mode="private"] .qbook__block--private + .qbook__block { margin-top: 0; }
  .qbook__step {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 5px 10px;
    margin-bottom: 14px;
  }
  .qbook__step--invert {
    color: rgba(255, 255, 255, 0.75);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .qbook__block-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .qbook__block-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
    max-width: 620px;
  }

  .qbook__block:not(.qbook__block--private) {
    background: var(--paper-3);
    border: 1px solid var(--border);
    padding: 32px;
  }
  .qbook__wizard { margin-top: 8px; }
  /* Neutralize the wizard's own internal max-width/px-4 so it aligns with the block padding */
  .qbook__wizard :global(#book-tour) { margin-bottom: 0; }
  .qbook__wizard :global(#book-tour > div) { max-width: none; padding: 0; }
  .qbook__wizard :global(.min-h-\[400px\]) { min-height: 0; }

  /* --- private tour panel --- */
  .qbook__block--private { padding: 0; }
  .qbook__private {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 40px;
    align-items: center;
    background: var(--ink);
    color: var(--paper-3);
    padding: 40px;
    border-radius: 2px;
  }
  .qbook__private-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.1;
    color: var(--paper-3);
    margin: 0 0 12px;
  }
  .qbook__private-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 20px;
    max-width: 52ch;
  }
  .qbook__private-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
  }
  .qbook__private-points li {
    position: relative;
    padding-left: 20px;
  }
  .qbook__private-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 1px;
    background: var(--gold);
  }

  .qbook__private-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }
  .qbook__private-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 20px 28px;
    background: var(--paper-3);
    color: var(--ink);
    border: 1px solid var(--paper-3);
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .qbook__private-cta:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--paper-3);
  }
  .qbook__private-wa {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .qbook__private-wa:hover { color: var(--paper-3); }

  /* --- contact + partners --- */
  .qbook__chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }
  .qbook__chip {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--paper-3);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .qbook__chip:hover { border-color: var(--ink); }
  .qbook__chip-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .qbook__chip-value {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink);
  }

  .qbook__partners { margin-top: 48px; }

  @media (max-width: 900px) {
    .qbook__private { grid-template-columns: 1fr; gap: 28px; padding: 32px 24px; }
    .qbook__private-title { font-size: 27px; }
  }

  @media (max-width: 760px) {
    .qbook { padding: 64px 20px; }
    .qbook__block:not(.qbook__block--private) { padding: 24px 18px; }
    .qbook__block-title { font-size: 24px; }
    .qbook__chips { grid-template-columns: 1fr; }
  }
</style>

<script>
  const section = document.getElementById('book');

  // Hand the wizard above over to its private path, then bring it back into
  // view — the form it switches to sits higher on the page than this button.
  document.querySelectorAll<HTMLElement>('[data-private-tour]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('pht:private-tour', { detail: el.dataset.privateTour || undefined }));
      const target = document.getElementById('book-tour');
      if (!target) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    });
  });

  // Mirror the wizard's mode onto the section so the block headings match what
  // the wizard is actually showing.
  window.addEventListener('pht:booking-mode', (e) => {
    if (!section) return;
    section.dataset.bookingMode = (e as CustomEvent<string>).detail;
  });
</script>
