---
import { Picture } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import { GOOGLE_REVIEWS, GOOGLE_MAPS_URL, TOUR_PRICES } from '../../data/site';
import heroGuide from '../../images/hero/hero-col-1-guide.webp';
import heroLuxembourg from '../../images/hero/hero-col-2-luxembourg.webp';
import heroGroup from '../../images/hero/hero-col-3-group.webp';

const lang = Astro.locals.lang;
const t = useTranslations(lang);

// The primary CTA carries the entry price — "how much?" answered above the fold.
const minPrice = Math.min(...Object.values(TOUR_PRICES).map(Number));
const bookPriceLabel = (t('quiet.common.fromPriceShort') as string).replace('{price}', String(minPrice));

// AVIF est retiré des <Picture> du hero : mesuré sur ces photos, il sort 40 à
// 65 % plus lourd que le WebP à toutes les largeurs, et serait toujours choisi.
// Trois colonnes : qui vous guide · le lieu · le groupe. Elles partent décalées
// et dérivent à des vitesses différentes au défilement (voir la feuille de style).
const columns = [
  { src: heroGuide,      key: 'mediaGuide', modifier: 'a', eager: true },
  { src: heroLuxembourg, key: 'mediaPlace', modifier: 'b', eager: false },
  { src: heroGroup,      key: 'mediaGroup', modifier: 'c', eager: false },
];

const stats = [
  { value: t('quiet.home.hero.statToursValue'),     label: t('quiet.home.hero.statToursLabel') },
  { value: t('quiet.home.hero.statYearsValue'),     label: t('quiet.home.hero.statYearsLabel') },
  { value: t('quiet.home.hero.statCountriesValue'), label: t('quiet.home.hero.statCountriesLabel') },
  { value: t('quiet.home.hero.statRatingValue'),    label: t('quiet.home.hero.statRatingLabel') },
  { value: t('quiet.home.hero.statGroupValue'),     label: t('quiet.home.hero.statGroupLabel') },
];
---

<section class="qhero">
  <div class="qhero__inner">
    <div class="qhero__tag">{t('quiet.home.hero.posterTag')}</div>

    <h1 class="qhero__headline">
      {t('quiet.home.hero.headlineLead')}{' '}<em class="qhero__accent">{t('quiet.home.hero.headlineAccent')}</em>{t('quiet.home.hero.headlineTail')}
    </h1>

    <p class="qhero__lede">{t('quiet.home.hero.lede')}</p>

    <a class="qhero__rating" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">
      <span class="qhero__rating-stars" aria-hidden="true">★★★★★</span>
      <b>{GOOGLE_REVIEWS.ratingValue}</b>
      <span class="qhero__rating-count">· {GOOGLE_REVIEWS.ratingCount} {t('quiet.common.googleReviews')}</span>
    </a>

    <div class="qhero__cta-row">
      <a href="#book" class="qhero__btn qhero__btn--primary" data-track="cta_hero_book">{t('quiet.home.hero.bookCta')} <span class="qhero__btn-price">· {bookPriceLabel}</span> <span aria-hidden="true">→</span></a>
      <a href="#tours" class="qhero__btn qhero__btn--ghost">{t('quiet.home.hero.browseCta')}</a>
    </div>

    <div class="qhero__media">
      {columns.map((col) => (
        <figure class:list={['qhero__frame', `qhero__frame--${col.modifier}`]}>
          <Picture src={col.src} alt={t(`quiet.home.hero.${col.key}Alt`)} widths={[360, 540, 720, 900]} sizes="(max-width:900px) 76vw, 33vw" formats={["webp"]} fallbackFormat="webp" quality={72} loading={col.eager ? 'eager' : 'lazy'} class="qhero__img" />
          <figcaption><b>{t(`quiet.home.hero.${col.key}Label`)}</b>{t(`quiet.home.hero.${col.key}Caption`)}</figcaption>
        </figure>
      ))}
    </div>

    <div class="qhero__stats">
      {stats.map((s) => (
        <div class="qhero__stat">
          <b>{s.value}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .qhero {
    background: var(--paper);
    padding: 64px 32px 96px;
  }
  .qhero__inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .qhero__tag {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--rouge);
    margin-bottom: 28px;
  }
  .qhero__tag::before,
  .qhero__tag::after {
    content: "";
    display: inline-block;
    width: 48px;
    height: 1px;
    background: var(--ink);
    opacity: 0.3;
  }

  .qhero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 5.4vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 24ch;
    margin: 0 auto;
  }
  .qhero__accent {
    color: var(--rouge);
    font-style: italic;
    font-weight: 500;
  }

  .qhero__lede {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 58ch;
    margin: 24px auto 26px;
  }

  .qhero__rating {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    text-decoration: none;
    margin-bottom: 26px;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .qhero__rating:hover { color: var(--ink); border-bottom-color: var(--ink); }
  .qhero__rating-stars { color: var(--rouge); letter-spacing: 2px; font-size: 12px; }
  .qhero__rating b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }

  .qhero__btn-price { font-weight: 400; opacity: 0.85; }

  .qhero__cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }
  .qhero__btn {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 14px 24px;
    border-radius: 2px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
    border: 1px solid var(--ink);
  }
  .qhero__btn--primary { background: var(--ink); color: var(--paper-3); }
  .qhero__btn--primary:hover { background: var(--rouge); border-color: var(--rouge); }
  .qhero__btn--ghost { background: transparent; color: var(--ink); }
  .qhero__btn--ghost:hover { background: var(--ink); color: var(--paper-3); }

  /* Trois colonnes de largeur égale, volontairement désalignées. */
  .qhero__media {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start;
    margin: 48px 0 88px;
    text-align: left;
  }
  .qhero__frame {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--paper-2);
  }
  /* Décalage de départ : le bloc ne se lit pas comme une rangée alignée. */
  .qhero__frame--b { margin-top: 44px; }
  .qhero__frame--c { margin-top: 18px; }

  /* Au défilement, chaque colonne dérive à sa propre vitesse : celle du centre
     avance, les deux autres reculent. Animation pilotée par le scroll, donc
     aucun JavaScript et aucune saccade. Sans support, les colonnes restent
     simplement décalées — la mise en page tient toute seule. */
  @keyframes qheroDrift {
    to { transform: translateY(var(--drift)); }
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .qhero__frame {
        animation: qheroDrift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 90vh;
      }
      .qhero__frame--a { --drift: 36px; }
      .qhero__frame--b { --drift: -72px; }
      .qhero__frame--c { --drift: 14px; }
    }
  }

  .qhero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }
  .qhero__media figure:hover .qhero__img { transform: scale(1.03); }
  .qhero__media figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 14px 16px 12px;
    background: linear-gradient(to top, rgba(26,26,26,0.72), rgba(26,26,26,0));
    color: var(--paper-3);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }
  .qhero__media figcaption b {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    margin-bottom: 2px;
    letter-spacing: 0;
  }

  .qhero__stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    max-width: 880px;
    margin: 8px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .qhero__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 16px;
    border-right: 1px solid var(--border);
  }
  .qhero__stat:last-child { border-right: 0; }
  .qhero__stat b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 32px;
    color: var(--ink);
    line-height: 1;
  }
  .qhero__stat span {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .qhero { padding: 48px 20px 72px; }
    /* Sous 900px les trois cadres deviennent un défilement tactile à accroche,
       comme la liste des étapes sur les pages de visite. Ni décalage ni dérive :
       sur une colonne étroite, ils ne feraient que désaligner la lecture. */
    .qhero__media {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 76%;
      gap: 12px;
      margin: 36px 0 48px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 8px;
    }
    .qhero__media::-webkit-scrollbar { display: none; }
    .qhero__frame { scroll-snap-align: start; }
    .qhero__frame--b,
    .qhero__frame--c { margin-top: 0; }
    .qhero__frame { animation: none; }
    .qhero__stats { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .qhero__stat { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 16px; }
    .qhero__stat:nth-child(n+3) { border-bottom: 0; }
    .qhero__lede { font-size: 17px; }
  }
</style>
