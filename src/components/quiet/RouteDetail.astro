---
import { useTranslations } from '../../i18n/utils';
import TourMap from '../TourMap.tsx';
import { buildStopDetails } from '../../lib/stopDetails';
import type { TourConfig } from '../../data/tours';

interface Props {
  tour: TourConfig;
  /** "ww2", "general", or "foodWine" */
  variant: 'ww2' | 'general' | 'foodWine';
}

const { tour, variant } = Astro.props;
const lang = Astro.locals.lang;
const t = useTranslations(lang);

const title =
  variant === 'general'  ? t('quiet.tour.route.titleGeneral')  :
  variant === 'foodWine' ? t('quiet.tour.route.titleFoodWine') :
                           t('quiet.tour.route.titleWW2');
const subtitle =
  variant === 'general'  ? t('quiet.tour.route.subtitleGeneral')  :
  variant === 'foodWine' ? t('quiet.tour.route.subtitleFoodWine') :
                           t('quiet.tour.route.subtitleWW2');

// Mêmes médaillons photo et mêmes noms que sur la carte de l'accueil : les
// titres d'arrêts viennent des traductions de la visite affichée.
const tp = tour.translationPrefix;
const stopDetails = buildStopDetails(
  tour.slug as Parameters<typeof buildStopDetails>[0],
  Array.from({ length: tour.stopCount }, (_, i) => ({
    title: t(`tours.${tp}.stops.stop${i + 1}.title`) as string,
    // Les phrases courtes de la carte d'accueil, pas les descriptions
    // complètes de la page : une bulle ne tient pas un paragraphe.
    blurb: t(`quiet.home.route.blurbs.${tp}.s${i + 1}`) as string,
    // La fiche de survol, elle, a la place d'en dire deux phrases.
    description: t(`tours.${tp}.stops.stop${i + 1}.description`) as string,
  })),
);
---

<section id="route" class="qrd">
  <div class="qrd__inner">
    <header class="qrd__header">
      <p class="qrd__kicker">{t('quiet.tour.route.kicker')}</p>
      <h2 class="qrd__title">{title}</h2>
      <p class="qrd__subtitle">{subtitle}</p>
    </header>

    <div class="qrd__map">
      <TourMap
        tour={tour.slug as 'left-bank' | 'right-bank' | 'general-history'}
        details={stopDetails}
        client:visible
      />
    </div>
  </div>
</section>

<style>
  .qrd { background: var(--paper-2); padding: 96px 32px; }
  .qrd__inner { max-width: 1280px; margin: 0 auto; }
  .qrd__header {
    text-align: center;
    margin: 0 auto 48px;
    max-width: 640px;
  }
  .qrd__kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rouge);
    margin: 0 0 16px;
  }
  .qrd__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .qrd__subtitle {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  .qrd__map {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--paper-3);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .qrd__map > * { width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .qrd { padding: 64px 20px; }
    .qrd__map { aspect-ratio: 4 / 3; }
  }
</style>
