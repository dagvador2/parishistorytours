---
import { Picture } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import { TOUR_PRICES } from '../../data/site';
import { formatEUR } from '../../lib/price';
import leftBankImg from '../../images/notre-dame-de-paris.webp';
import rightBankImg from '../../images/place_vendome_paris_day.webp';
import generalImg from '../../images/luxembourg_palace_paris.webp';
import foodWineImg from '../../images/food_wine_degustation.webp';

const lang = Astro.locals.lang;
const t = useTranslations(lang);
const langPrefix = lang === 'en' ? '' : '/fr';

// All four tours from the grid above appear here — a three-column comparison
// under a four-card grid reads as a contradiction, not as a shortlist.
const tours = [
  {
    slug: 'left-bank',
    img: leftBankImg,
    alt: t('quiet.home.tours.leftBankImgAlt') as string,
    numeral: t('quiet.home.tours.leftBankNumeral') as string,
    title: t('quiet.home.tours.leftBankTitle') as string,
    href: `${langPrefix}/tours/left-bank/`,
    focus: t('quiet.home.compare.leftBankFocus') as string,
    route: t('quiet.home.compare.leftBankRoute') as string,
    duration: t('quiet.home.compare.leftBankDuration') as string,
    stops: t('quiet.home.compare.leftBankStops') as string,
    bestFor: t('quiet.home.compare.leftBankBestFor') as string,
  },
  {
    slug: 'right-bank',
    img: rightBankImg,
    alt: t('quiet.home.tours.rightBankImgAlt') as string,
    numeral: t('quiet.home.tours.rightBankNumeral') as string,
    title: t('quiet.home.tours.rightBankTitle') as string,
    href: `${langPrefix}/tours/right-bank/`,
    focus: t('quiet.home.compare.rightBankFocus') as string,
    route: t('quiet.home.compare.rightBankRoute') as string,
    duration: t('quiet.home.compare.rightBankDuration') as string,
    stops: t('quiet.home.compare.rightBankStops') as string,
    bestFor: t('quiet.home.compare.rightBankBestFor') as string,
  },
  {
    slug: 'general-history',
    img: generalImg,
    alt: 'Palais du Luxembourg',
    numeral: t('quiet.home.tours.generalNumeral') as string,
    title: t('quiet.home.tours.generalTitle') as string,
    href: `${langPrefix}/tours/general-history/`,
    focus: t('quiet.home.compare.generalFocus') as string,
    route: t('quiet.home.compare.generalRoute') as string,
    duration: t('quiet.home.compare.generalDuration') as string,
    stops: t('quiet.home.compare.generalStops') as string,
    bestFor: t('quiet.home.compare.generalBestFor') as string,
  },
  {
    slug: 'food-wine',
    img: foodWineImg,
    alt: 'Nourritour — Food & Wine',
    numeral: t('quiet.home.tours.foodWineNumeral') as string,
    title: t('quiet.home.tours.foodWineTitle') as string,
    href: `${langPrefix}/tours/food-wine/`,
    focus: t('quiet.home.compare.foodWineFocus') as string,
    route: t('quiet.home.compare.foodWineRoute') as string,
    duration: t('quiet.home.compare.foodWineDuration') as string,
    stops: t('quiet.home.compare.foodWineStops') as string,
    bestFor: t('quiet.home.compare.foodWineBestFor') as string,
  },
];

type AxisKey = 'focus' | 'duration' | 'route' | 'stops' | 'bestFor';

// Ordered by how much each line actually decides the choice. `emphasis` gets
// the value darker, larger type so the eye lands on the differences first.
const axes: { key: AxisKey; label: string; emphasis?: boolean }[] = [
  { key: 'focus',    label: t('quiet.home.compare.axisFocus') as string, emphasis: true },
  { key: 'duration', label: t('quiet.home.compare.axisDuration') as string, emphasis: true },
  { key: 'route',    label: t('quiet.home.compare.axisRoute') as string },
  { key: 'stops',    label: t('quiet.home.compare.axisStops') as string },
  { key: 'bestFor',  label: t('quiet.home.compare.axisBestFor') as string },
];

const fromLabel = t('quiet.common.from') as string;
const priceLabel = t('quiet.home.compare.axisPrice') as string;
const viewCta = t('quiet.home.compare.viewCta') as string;
const bookCta = t('quiet.home.compare.bookCta') as string;
const price = (slug: string) => formatEUR(lang, TOUR_PRICES[slug]);
---

<section id="compare" class="qcompare">
  <div class="qcompare__inner">
    <header class="qcompare__header qreveal">
      <p class="qcompare__kicker">{t('quiet.home.compare.kicker')}</p>
      <h2 class="qcompare__title">{t('quiet.home.compare.title')}</h2>
      <p class="qcompare__lead">{t('quiet.home.compare.lead')}</p>
    </header>

    <!-- Wide screens: a real table, so every row stays aligned across columns -->
    <div class="qcompare__tablewrap">
      <table class="qcompare__table">
        <colgroup>
          <col class="qcompare__col-rail" />
          {tours.map(() => <col class="qcompare__col-tour" />)}
        </colgroup>
        <thead>
          <tr>
            <td class="qcompare__rail qcompare__rail--head"></td>
            {tours.map((tour) => (
              <th scope="col" class="qcompare__head">
                <a href={tour.href} class="qcompare__headlink">
                  <span class="qcompare__thumb">
                    <Picture
                      src={tour.img}
                      alt={tour.alt}
                      width={520}
                      height={Math.round((520 / tour.img.width) * tour.img.height)}
                      widths={[260, 520]}
                      sizes="(max-width: 900px) 84vw, 260px"
                      formats={["avif", "webp"]}
                      fallbackFormat="webp"
                      quality={78}
                      loading="lazy"
                    />
                    <span class="qcompare__numeral" aria-hidden="true">{tour.numeral}</span>
                  </span>
                  <span class="qcompare__name">{tour.title}</span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="qcompare__rail">{priceLabel}</th>
            {tours.map((tour) => (
              <td class="qcompare__cell">
                <span class="qcompare__price"><i>{fromLabel}</i><b>{price(tour.slug)}</b></span>
              </td>
            ))}
          </tr>
          {axes.map((axis) => (
            <tr>
              <th scope="row" class="qcompare__rail">{axis.label}</th>
              {tours.map((tour) => (
                <td class:list={['qcompare__cell', { 'is-emphasis': axis.emphasis }]}>{tour[axis.key]}</td>
              ))}
            </tr>
          ))}
          <tr>
            <td class="qcompare__rail qcompare__rail--foot"></td>
            {tours.map((tour) => (
              <td class="qcompare__cell qcompare__cell--actions">
                <div class="qcompare__actions">
                  <a href="#book" class="qcompare__book" data-select-tour={tour.slug} data-track="compare_book">{bookCta}</a>
                  <a href={tour.href} class="qcompare__view">{viewCta} <span aria-hidden="true">→</span></a>
                </div>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

<style>
  .qcompare {
    background: var(--paper-2);
    padding: 96px 32px;
  }
  .qcompare__inner { max-width: 1280px; margin: 0 auto; }
  .qcompare__header { margin-bottom: 48px; max-width: 720px; }
  .qcompare__kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 16px;
  }
  .qcompare__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.2vw, 48px);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 16px;
    line-height: 1.1;
  }
  .qcompare__lead {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
  }

  /* --- wide-screen table --- */
  .qcompare__table {
    table-layout: fixed;
    border-collapse: separate;
    /* Horizontal spacing separates the columns into distinct blocks; the
       column background below then reads as a card per tour. The negative
       margin cancels the spacing border-spacing also adds at both edges. */
    border-spacing: 16px 0;
    margin: 0 -16px;
    width: calc(100% + 32px);
  }
  /* Column tint is what replaces the old borderless rows: each tour is a
     legible vertical block instead of six loose lines of text. */
  .qcompare__col-tour { background: var(--paper-3); }
  .qcompare__col-rail { width: 128px; }

  .qcompare__rail {
    text-align: left;
    vertical-align: middle;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding: 16px 0;
    border-top: 1px solid var(--border);
    white-space: nowrap;
  }
  .qcompare__rail--head,
  .qcompare__rail--foot { border-top: none; padding: 0; }
  .qcompare__rail--foot { border-top: 1px solid transparent; }

  .qcompare__head {
    text-align: left;
    vertical-align: bottom;
    font-weight: 400;
    padding: 16px 16px 18px;
  }
  .qcompare__headlink {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }
  .qcompare__thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-2);
  }
  .qcompare__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }
  .qcompare__headlink:hover .qcompare__thumb :global(img) { transform: scale(1.04); }
  .qcompare__numeral {
    position: absolute;
    bottom: 8px;
    left: 8px;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: var(--paper-3);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    border-radius: 50%;
  }
  .qcompare__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.15;
    color: var(--ink);
  }
  .qcompare__headlink:hover .qcompare__name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .qcompare__cell {
    vertical-align: middle;
    padding: 16px;
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .qcompare__cell.is-emphasis {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .qcompare__price {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .qcompare__price i {
    font-style: normal;
    font-size: 12px;
    color: var(--ink-2);
  }
  .qcompare__price b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
  }

  .qcompare__cell--actions { padding-bottom: 20px; }
  .qcompare__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .qcompare__book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--paper-3);
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .qcompare__book:hover { background: var(--rouge); border-color: var(--rouge); }
  .qcompare__view {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
  }
  .qcompare__view:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }


  @media (max-width: 1100px) {
    .qcompare__col-rail { width: 104px; }
    .qcompare__table { border-spacing: 10px 0; margin: 0 -10px; width: calc(100% + 20px); }
    .qcompare__cell, .qcompare__head { padding-left: 12px; padding-right: 12px; }
    .qcompare__name { font-size: 18px; }
    .qcompare__rail { font-size: 9px; letter-spacing: 0.12em; }
    .qcompare__price b { font-size: 22px; }
  }

  /* Sous 900px la section ne s'affiche pas du tout. Les cartes de visite
     juste au-dessus portent déjà la photo, le tarif, la durée, le parcours et
     le nombre d'arrêts : comparer n'y ajoutait qu'un rail horizontal de plus,
     le quatrième de la page. */
  @media (max-width: 900px) {
    .qcompare { display: none; }
  }
</style>

<script>
  // "Book" pre-selects that tour in the wizard further down the page, the same
  // way the tour cards do; the #book anchor then scrolls to it.
  document.querySelectorAll<HTMLElement>('#compare [data-select-tour]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('pht:select-tour', { detail: el.dataset.selectTour }));
    });
  });
</script>
