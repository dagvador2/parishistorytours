---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/quiet/Nav.astro";
import { useTranslations } from '../i18n/utils';
import { waLink } from '../lib/whatsapp';

const lang = Astro.locals.lang;
const t = useTranslations(lang);
const langPrefix = lang === 'fr' ? '/fr' : '';
const waHref = waLink(t('quiet.wa.booked') as string);
---
<BaseLayout title={t('meta.success.title')} description={t('meta.success.description')} noindex={true} theme="quiet">
  <Nav context="tour" />
  <main>
    <section class="qsuccess">
      <div class="qsuccess__inner">
        <div class="qsuccess__check" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h1 class="qsuccess__title">{t('booking.success.title')}</h1>
        <p class="qsuccess__message">{t('booking.success.message')}</p>
        <div class="qsuccess__actions">
          <a href={`${langPrefix}/#tours`} class="qsuccess__btn qsuccess__btn--primary">{t('quiet.home.hero.browseCta')}</a>
          <a href={waHref} class="qsuccess__btn qsuccess__btn--ghost" rel="noopener">{t('quiet.footer.whatsapp')}</a>
          <a href={`${langPrefix}/`} class="qsuccess__btn qsuccess__btn--ghost">{t('booking.success.returnHome')}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from '../scripts/track';
  // Stripe redirects here after a successful payment — count it as the
  // client-side purchase confirmation (server truth lives in the webhook).
  track('purchase_confirmation', { path: location.pathname });
</script>

<style>
  .qsuccess {
    background: var(--paper);
    padding: 96px 24px 120px;
    min-height: 55vh;
  }
  .qsuccess__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .qsuccess__check {
    width: 64px;
    height: 64px;
    margin: 0 auto 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    color: var(--ink);
  }
  .qsuccess__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 5vw, 44px);
    color: var(--ink);
    margin: 0 0 16px;
  }
  .qsuccess__message {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 auto 36px;
    max-width: 46ch;
  }
  .qsuccess__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .qsuccess__btn {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 13px 22px;
    border-radius: 2px;
    border: 1px solid var(--ink);
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  .qsuccess__btn--primary { background: var(--ink); color: var(--paper-3); }
  .qsuccess__btn--primary:hover { background: var(--rouge); border-color: var(--rouge); }
  .qsuccess__btn--ghost { background: transparent; color: var(--ink); }
  .qsuccess__btn--ghost:hover { background: var(--ink); color: var(--paper-3); }
</style>
