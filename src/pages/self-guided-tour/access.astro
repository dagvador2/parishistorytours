---
/**
 * The audioguide webapp. Access is bound to a purchase token (?token=…, from
 * the purchase email) and is time-limited. When the query carries a token it
 * is validated here so a wrong or expired link gets a clear page; without a
 * query the shell is rendered and the client uses the token it remembered
 * (installed PWA).
 */
import SelfGuidedLayout from "../../layouts/SelfGuidedLayout.astro";
import AudioGuideApp from "../../components/self-guided/App";
import { accessExpired, accessNotOpenYet, findPurchaseByToken, SUPPORT_EMAIL } from "../../lib/self-guided/purchase";
import { WHATSAPP_NUMBER } from "../../lib/whatsapp";

export const prerender = false;

const lang = Astro.locals.lang;
const isFr = lang === "fr";
const title = isFr ? "WWII Left Bank · Visite libre" : "WWII Left Bank · Self-guided tour";
const token = Astro.url.searchParams.get("token");

let state: "ok" | "invalid" | "expired" | "notOpen" = "ok";
let opensAt: string | null = null;
if (token) {
  try {
    const purchase = await findPurchaseByToken(token);
    if (!purchase) state = "invalid";
    else if (accessExpired(purchase)) state = "expired";
    else if (accessNotOpenYet(purchase)) {
      state = "notOpen";
      opensAt = purchase.access_starts_at;
    }
  } catch (e) {
    console.error("[self-guided/access page] token check failed:", e);
    // Database hiccup: let the client retry through the API rather than blocking a paying visitor.
  }
}
if (state === "invalid") Astro.response.status = 401;
if (state === "expired") Astro.response.status = 410;
if (state === "notOpen") Astro.response.status = 403;

const opensLabel = opensAt
  ? new Date(opensAt).toLocaleDateString(isFr ? "fr-FR" : "en-GB", { day: "numeric", month: "long" })
  : "";

const copy = {
  invalid: {
    title: isFr ? "Ce lien n’ouvre pas la visite" : "This link does not open the tour",
    body: isFr
      ? "Ce lien d’accès n’est pas valide. Vérifiez le lien de votre email d’achat, ou contactez Clément."
      : "This access link is not valid. Check the link in your purchase email, or contact Clément.",
  },
  expired: {
    title: isFr ? "Cet accès a expiré" : "This access has expired",
    body: isFr
      ? "Votre lien était valable quelques jours après l’achat. Si vous n’avez pas pu faire la visite, écrivez-moi et je le rouvre."
      : "Your link was valid for a few days after purchase. If you did not get to walk the tour, write to me and I will reopen it.",
  },
  notOpen: {
    title: isFr ? "Pas encore ouvert" : "Not open yet",
    body: isFr
      ? `Vous avez choisi une date plus tard. La visite s’ouvre la veille au soir, le ${opensLabel}. Revenez à ce moment-là, le lien reste le même.`
      : `You chose to walk on a later date. The tour opens on the evening before, on ${opensLabel}. Come back then — the link stays the same.`,
  },
}[state === "ok" ? "invalid" : state];
const prefix = isFr ? "/fr" : "";
---
<SelfGuidedLayout lang={lang} title={title}>
  {state !== "ok" ? (
    <div class="ag-app">
      <div class="ag-center">
        <div class="ag-monogram">P</div>
        <div class="ag-center__title">{copy.title}</div>
        <div>{copy.body}</div>
        <div class="ag-center__actions">
          <a class="ag-btn-ghost" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="ag-btn-ghost" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
          <a class="ag-btn-ghost" href={`${prefix}/self-guided-tour`}>{isFr ? "Voir la visite libre" : "See the self-guided tour"}</a>
        </div>
      </div>
    </div>
  ) : (
    <div class="ag-app">
      <div class="ag-splash" id="ag-splash" aria-hidden="true">
        <div class="ag-monogram">P</div>
        <div>{isFr ? "Chargement de votre visite…" : "Loading your tour…"}</div>
      </div>
      <AudioGuideApp client:only="react" lang={lang} />
    </div>
  )}
</SelfGuidedLayout>
