---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { useTranslations } from '../i18n/utils';
import { fetchPublishedFigures, figuresSummary } from '../lib/tour-stats';
import { GOOGLE_REVIEWS } from '../data/site';

import Nav from '../components/quiet/Nav.astro';
import MobileBookingBar from '../components/quiet/MobileBookingBar.astro';
import AboutHero from '../components/quiet/AboutHero.astro';
import GuideBio from '../components/quiet/GuideBio.astro';
import FeaturedOn from '../components/quiet/FeaturedOn.astro';
import BuildingTours from '../components/quiet/BuildingTours.astro';
import AboutStats from '../components/quiet/AboutStats.astro';
import AboutCTA from '../components/quiet/AboutCTA.astro';

const lang = Astro.locals.lang;
const t = useTranslations(lang);

const isDefaultLang = lang === 'en';
const langPrefix = isDefaultLang ? '' : '/fr';

// Published figures come from two aggregate views rebuilt from the tracking
// workbook (`pnpm tracking:import`). See src/lib/tour-stats.ts.
const { figures, countries } = await fetchPublishedFigures(lang);

const stats = [
  { label: lang === 'fr' ? 'Participants' : 'Participants', value: figures.participants },
  { label: lang === 'fr' ? 'Visites guidées' : 'Tours conducted', value: figures.toursConducted },
  { label: lang === 'fr' ? 'Kilomètres parcourus' : 'Kilometres walked', value: figures.kilometers },
  { label: lang === 'fr' ? 'Pays représentés' : 'Countries represented', value: figures.countries },
];

const maxCount = Math.max(...countries.map((c) => c.participants), 1);
const topCountries = countries.slice(0, 5).map((c) => ({
  country: c.name,
  count: c.participants,
  code: c.code,
  percentage: (c.participants / maxCount) * 100,
}));

// The map keys on the ISO numeric id carried by every geometry of
// public/data/world-110m.json, so a country shades whatever its label was.
const mapCountries = countries
  .filter((c) => c.numeric)
  .map((c) => ({ id: c.numeric, code: c.code, name: c.name, count: c.participants }));

const summary = figuresSummary(figures, countries, lang, GOOGLE_REVIEWS);
---

<BaseLayout
  title={t('meta.keyFigures.title')}
  description={t('meta.keyFigures.description')}
  ogImage="/photos/left_bank/Paris_WW2_guide.webp"
  theme="quiet"
>
  <Nav context="tour" />

  <main>
    <AboutHero />
    <GuideBio />
    <FeaturedOn />
    <BuildingTours />
    <AboutStats
      stats={stats}
      topCountries={topCountries}
      mapCountries={mapCountries}
      mapMax={maxCount}
      summary={summary}
    />
    <AboutCTA
      bookHref={`${langPrefix}/#book`}
      toursHref={`${langPrefix}/#tours`}
    />
  </main>

  <MobileBookingBar href={`${langPrefix}/#book`} />

  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Clement Daguet-Schott",
    "givenName": "Clement",
    "familyName": "Daguet-Schott",
    "jobTitle": "WWII History Guide & Researcher",
    "description": "Independent history guide in Paris specializing in World War II walking tours. Conducted extensive research across 20+ historical texts over 6 months to create immersive experiences visiting landmarks from the Fall, Resistance, and Liberation of Paris.",
    "worksFor": {
      "@type": "LocalBusiness",
      "name": "Paris History Tours",
      "url": "https://www.parishistorytours.com"
    },
    "knowsAbout": [
      "World War II in Paris",
      "French Resistance",
      "Liberation of Paris 1944",
      "Fall of France 1940",
      "Nazi occupation of Paris",
      "Rose Valland and Nazi art theft",
      "Ernest Hemingway and the Liberation",
      "Agnes Humbert and Musee de l'Homme network",
      "Charles de Gaulle"
    ],
    "knowsLanguage": ["en", "fr"],
    "image": "https://www.parishistorytours.com/photos/left_bank/Paris_WW2_guide.webp",
    "url": "https://www.parishistorytours.com/key-figures",
    "sameAs": [
      "https://maps.app.goo.gl/AGYuzh8jHA9KXv9h8",
      "https://www.instagram.com/parishistorytours/",
      "https://www.getyourguide.com/paris-l16/world-war-ii-tour-in-paris-fall-resistance-liberation-t537162/",
      "https://www.viator.com/tours/Paris/World-War-II-Tour-in-Paris-Fall-Resistance-and-Liberation/d479-5642691P2",
      "https://www.tripadvisor.fr/Attraction_Review-g187147-d34229671-Reviews-Paris_History_Tours-Paris_Ile_de_France.html"
    ]
  }} />
</BaseLayout>

<script>
  import { initQuietNav } from '../scripts/quiet-nav';
  initQuietNav();
</script>
