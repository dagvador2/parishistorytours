---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { useTranslations } from '../i18n/utils';

import JsonLd from "../components/JsonLd.astro";
import { GOOGLE_REVIEWS, GOOGLE_MAPS_URL, TOUR_PRICES } from "../data/site";

// Quiet chrome + sections
import Nav from "../components/quiet/Nav.astro";
import MobileBookingBar from "../components/quiet/MobileBookingBar.astro";
import HeroHome from "../components/quiet/HeroHome.astro";
import FeaturedOn from "../components/quiet/FeaturedOn.astro";
import TourGrid from "../components/quiet/TourGrid.astro";
import RouteSection from "../components/quiet/RouteSection.astro";
import CompareSection from "../components/quiet/CompareSection.astro";
import Reviews from "../components/quiet/Reviews.astro";
import AboutSection from "../components/quiet/AboutSection.astro";
import BookingSection from "../components/quiet/BookingSection.astro";
import FAQ from "../components/quiet/FAQ.astro";

const lang = Astro.locals.lang;
const t = useTranslations(lang);
const isDefaultLang = lang === 'en';
const langPrefix = isDefaultLang ? '' : '/fr';
---

<BaseLayout
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  ogImage="/photos/left_bank/Paris_WW2_guide.webp"
  theme="quiet"
>
  <Nav context="home" />

  <main>
    <HeroHome />
    <FeaturedOn />
    <TourGrid />
    <RouteSection />
    <CompareSection />
    <Reviews />
    <AboutSection />
    <BookingSection />
    <FAQ />
  </main>

  <MobileBookingBar />

  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "TravelAgency"],
    "name": "Paris History Tours",
    "alternateName": t('jsonLd.alternateName'),
    "description": t('meta.home.description'),
    "url": "https://www.parishistorytours.com",
    "telephone": "+33620622480",
    "email": "clement@parishistorytours.com",
    "foundingDate": "2023",
    "slogan": t('jsonLd.slogan'),
    "knowsLanguage": ["en", "fr"],
    "currenciesAccepted": "EUR",
    "paymentAccepted": "Credit Card, Stripe",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Paris",
      "addressRegion": "Ile-de-France",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 48.8566,
      "longitude": 2.3522
    },
    "image": "https://www.parishistorytours.com/photos/left_bank/Paris_WW2_guide.webp",
    "priceRange": "$$",
    "aggregateRating": {
      "@type": "AggregateRating",
      ...GOOGLE_REVIEWS
    },
    "founder": {
      "@type": "Person",
      "name": "Clement Daguet-Schott",
      "givenName": "Clement",
      "familyName": "Daguet-Schott",
      "jobTitle": t('jsonLd.founderJobTitle'),
      "description": t('jsonLd.founderDescription'),
      "knowsAbout": ["World War II history", "Paris during WWII", "French Resistance", "Liberation of Paris 1944", "Nazi occupation of France"],
      "knowsLanguage": ["en", "fr"],
      "image": "https://www.parishistorytours.com/photos/left_bank/Paris_WW2_guide.webp",
      "url": "https://www.parishistorytours.com/key-figures"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": t('jsonLd.offerCatalogName'),
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "TouristTrip",
            "name": t('booking.leftBankTour'),
            "description": t('jsonLd.leftBankDescription'),
            "touristType": ["History enthusiast", "Cultural traveler"],
            "duration": "PT2H",
            "url": `https://www.parishistorytours.com${langPrefix}/tours/left-bank`,
            "offers": { "@type": "Offer", "price": TOUR_PRICES["left-bank"], "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "TouristTrip",
            "name": t('booking.rightBankTour'),
            "description": t('jsonLd.rightBankDescription'),
            "touristType": ["History enthusiast", "Cultural traveler"],
            "duration": "PT2H",
            "url": `https://www.parishistorytours.com${langPrefix}/tours/right-bank`,
            "offers": { "@type": "Offer", "price": TOUR_PRICES["right-bank"], "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "TouristTrip",
            "name": t('booking.generalHistoryTour'),
            "description": t('jsonLd.generalHistoryDescription'),
            "touristType": ["History enthusiast", "Cultural traveler", "First-time visitor"],
            "duration": "PT1H30M",
            "url": `https://www.parishistorytours.com${langPrefix}/tours/general-history`,
            "offers": { "@type": "Offer", "price": TOUR_PRICES["general-history"], "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "TouristTrip",
            "name": t('booking.foodWineTour'),
            "description": "A 3-hour food and wine walking tour through the 9th arrondissement of Paris — covered passages, the rue des Martyrs, four artisans (madeleines, cheese, charcuterie, wine) and four tasting flights.",
            "touristType": ["Food lover", "Wine enthusiast", "Cultural traveler"],
            "duration": "PT3H",
            "url": `https://www.parishistorytours.com${langPrefix}/tours/food-wine`,
            "offers": { "@type": "Offer", "price": TOUR_PRICES["food-wine"], "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
          }
        }
      ]
    },
    "areaServed": {
      "@type": "City",
      "name": "Paris",
      "containedInPlace": { "@type": "Country", "name": "France" }
    },
    "sameAs": [
      "https://maps.app.goo.gl/AGYuzh8jHA9KXv9h8",
      "https://www.instagram.com/parishistorytour/",
      "https://www.getyourguide.com/paris-l16/world-war-ii-tour-in-paris-fall-resistance-liberation-t537162/",
      "https://www.viator.com/tours/Paris/World-War-II-Tour-in-Paris-Fall-Resistance-and-Liberation/d479-5642691P2",
      "https://www.tripadvisor.fr/Attraction_Review-g187147-d34229671-Reviews-Paris_History_Tours-Paris_Ile_de_France.html"
    ]
  }} />

  {/* Site-name markup: without a WebSite node carrying an explicit `name`,
      Google falls back to the bare domain ("parishistorytours.com") in the
      SERP. The Organization node is the entity the site name hangs off. */}
  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `https://www.parishistorytours.com${langPrefix}/#website`,
    "name": "Paris History Tours",
    "alternateName": t('jsonLd.alternateName'),
    "url": `https://www.parishistorytours.com${langPrefix}/`,
    "inLanguage": lang === 'fr' ? 'fr-FR' : 'en-US',
    "publisher": { "@id": "https://www.parishistorytours.com/#organization" }
  }} />

  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.parishistorytours.com/#organization",
    "name": "Paris History Tours",
    "url": "https://www.parishistorytours.com/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.parishistorytours.com/apple-touch-icon.png",
      "width": 180,
      "height": 180
    },
    "email": "clement@parishistorytours.com",
    "telephone": "+33620622480",
    "foundingDate": "2023",
    "founder": { "@type": "Person", "name": "Clement Daguet-Schott" },
    "sameAs": [
      GOOGLE_MAPS_URL,
      "https://www.instagram.com/parishistorytour/",
      "https://www.getyourguide.com/paris-l16/world-war-ii-tour-in-paris-fall-resistance-liberation-t537162/",
      "https://www.viator.com/tours/Paris/World-War-II-Tour-in-Paris-Fall-Resistance-and-Liberation/d479-5642691P2",
      "https://www.tripadvisor.fr/Attraction_Review-g187147-d34229671-Reviews-Paris_History_Tours-Paris_Ile_de_France.html"
    ]
  }} />
</BaseLayout>

<script>
  import { initQuietNav } from '../scripts/quiet-nav';
  initQuietNav();
</script>
