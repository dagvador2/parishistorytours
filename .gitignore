# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.local
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

.vercel

# Full-resolution photo originals (optimized .webp versions live in public/photos/)
photo-originals/

# Self-guided tour pipeline — generated assets live on R2, only manifests are versioned
scripts/self-guided/output/*
!scripts/self-guided/output/manifest/

# Personal voice recordings used to clone the narration voice (never committed)
scripts/audio-source/voice-samples/

# Supabase CLI local cache
supabase/.temp/

# Sources of the self-guided tour: voice masters, source PNGs, camera originals.
# They stay on disk (the build reads them) and are backed up to R2 under
# masters/left-bank-ww2/ — see `pnpm self-guided:upload --only masters`.
scripts/audio-source/*/recordings/
design/audioguide-handoff/originals/
design/audioguide-handoff/video/
design/audioguide-handoff/photos/
