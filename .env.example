# ── Self-guided tour pipeline (scripts/self-guided) ─────────────────────────
# Fish Audio — TTS with word timestamps (https://docs.fish.audio)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=            # reference_id of the cloned voice (fallback for every language)
FISH_AUDIO_VOICE_ID_EN=         # clone trained on English takes (a FR-only clone reads EN with a heavy accent)
FISH_AUDIO_VOICE_ID_FR=         # optional override for French
FISH_AUDIO_MODEL=s2.1-pro-free  # s2.1-pro for paid production quality

# Cloudflare R2 — dedicated private bucket for the digital product
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=parishistorytours-self-guided
R2_JURISDICTION=eu              # bucket created under the EU jurisdiction -> <account>.eu.r2.cloudflarestorage.com

# ── Self-guided tour webapp (chantier B) ──────────────────────────────────────
SELF_GUIDED_DEV_TOKEN=          # optional: this exact ?token= opens the webapp without a purchase (field tests); unset in production

# ── Self-guided tour commerce (chantier C) ────────────────────────────────────
STRIPE_PRICE_ID_SELF_GUIDED_EARLYBIRD=   # price_… (900 cents), created by tools/create-stripe-product.ts
STRIPE_PRICE_ID_SELF_GUIDED_NORMAL=      # price_… (1400 cents)
SELF_GUIDED_LAUNCH_DATE=                 # ISO 8601, e.g. 2026-10-01T00:00:00Z — early bird for 30 days from there
PUBLIC_SITE_URL=https://www.parishistorytours.com   # origin used in the purchase email links (webhook has no browser origin)
