# ── Self-guided tour pipeline (scripts/self-guided) ─────────────────────────
# Fish Audio — TTS with word timestamps (https://docs.fish.audio)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=            # reference_id of the cloned voice
FISH_AUDIO_MODEL=s2.1-pro-free  # s2.1-pro for paid production quality

# Cloudflare R2 — dedicated private bucket for the digital product
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=parishistorytours-self-guided
